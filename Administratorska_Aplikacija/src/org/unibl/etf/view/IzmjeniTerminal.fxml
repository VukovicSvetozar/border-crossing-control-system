<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import java.lang.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.collections.*?>

<VBox alignment="CENTER" prefHeight="460.0" prefWidth="800.0" styleClass="kontejner" stylesheets="@../../../../resources/style/Dijalog.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.unibl.etf.controller.IzmjeniTerminal">
   <children>
      <GridPane alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints prefHeight="60.0" valignment="CENTER" vgrow="SOMETIMES" />
          <RowConstraints prefHeight="320.0" valignment="CENTER" vgrow="SOMETIMES" />
          <RowConstraints prefHeight="80.0" valignment="CENTER" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <HBox alignment="CENTER">
               <children>
                  <Label styleClass="labelaNaslov" text="Izmjeni terminal" textFill="#2b89ae">
                     <font>
                        <Font name="System Bold Italic" size="18.0" />
                     </font>
                  </Label>
               </children>
               <GridPane.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
               </GridPane.margin>
            </HBox>
            <HBox GridPane.rowIndex="1">
               <children>
                  <GridPane>
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" prefWidth="280.0" />
                        <ColumnConstraints hgrow="SOMETIMES" prefWidth="500.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints valignment="CENTER" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <VBox alignment="CENTER">
                           <opaqueInsets>
                              <Insets left="15.0" right="5.0" />
                           </opaqueInsets>
                           <GridPane.margin>
                              <Insets right="5.0" top="10.0" />
                           </GridPane.margin>
                           <children>
                              <VBox alignment="CENTER" minHeight="40.0" prefHeight="40.0">
                                 <children>
                                    <Label styleClass="labelaOznaka" text="Dodaj podatke">
                                       <font>
                                          <Font name="System Bold Italic" size="12.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </VBox>
                              <VBox minHeight="120.0" prefHeight="120.0">
                                 <children>
                                    <GridPane>
                                       <children>
                                          <Label styleClass="labelaVrijednost" text="Naziv terminala:">
                                             <font>
                                                <Font name="System Bold Italic" size="12.0" />
                                             </font>
                                             <GridPane.margin>
                                                <Insets left="20.0" />
                                             </GridPane.margin>
                                          </Label>
                                          <TextField fx:id="tfNaziv" GridPane.columnIndex="1">
                                             <GridPane.margin>
                                                <Insets right="15.0" />
                                             </GridPane.margin>
                                          </TextField>
                                          <Label styleClass="labelaVrijednost" text="Tip prolaza:" GridPane.rowIndex="1">
                                             <font>
                                                <Font name="System Bold Italic" size="12.0" />
                                             </font>
                                             <GridPane.margin>
                                                <Insets left="20.0" />
                                             </GridPane.margin>
                                          </Label>
                                          <ChoiceBox fx:id="cbTipProlaza" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                             <GridPane.margin>
                                                <Insets right="15.0" />
                                             </GridPane.margin>
                                          </ChoiceBox>
                                          <Label styleClass="labelaVrijednost" text="Id prolaza:" GridPane.rowIndex="2">
                                             <font>
                                                <Font name="System Bold Italic" size="12.0" />
                                             </font>
                                             <GridPane.margin>
                                                <Insets left="20.0" />
                                             </GridPane.margin>
                                          </Label>
                                          <TextField fx:id="tfIdProlaza" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                             <GridPane.margin>
                                                <Insets right="15.0" />
                                             </GridPane.margin>
                                          </TextField>
                                       </children>
                                       <columnConstraints>
                                          <ColumnConstraints hgrow="SOMETIMES" prefWidth="130.0" />
                                          <ColumnConstraints hgrow="SOMETIMES" prefWidth="145.0" />
                                       </columnConstraints>
                                       <rowConstraints>
                                          <RowConstraints prefHeight="40.0" vgrow="SOMETIMES" />
                                          <RowConstraints prefHeight="40.0" vgrow="SOMETIMES" />
                                          <RowConstraints prefHeight="40.0" vgrow="SOMETIMES" />
                                       </rowConstraints>
                                    </GridPane>
                                 </children>
                              </VBox>
                              <VBox alignment="TOP_CENTER" prefHeight="200.0">
                                 <children>
                                    <Button fx:id="btnDodajProlaz" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#dodajProlaz" prefHeight="45.0" prefWidth="80.0" styleClass="btnPrihvati" text="Dodaj" />
                                 </children>
                                 <padding>
                                    <Insets top="10.0" />
                                 </padding>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox GridPane.columnIndex="1">
                           <children>
                              <GridPane>
                                <columnConstraints>
                                  <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints prefHeight="40.0" valignment="CENTER" vgrow="SOMETIMES" />
                                  <RowConstraints prefHeight="270.0" valignment="CENTER" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <Label styleClass="labelaOznaka" text="Lista korisnika">
                                       <font>
                                          <Font name="System Bold Italic" size="12.0" />
                                       </font>
                                    </Label>
                                    <TableView fx:id="tvKorisnici" prefHeight="260.0" GridPane.rowIndex="1">
                                       <columns>
                                          <TableColumn fx:id="tcId" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="50.0" text="Id" />
                                          <TableColumn fx:id="tcTipProlaza" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" text="Tip prolaza" />
                                          <TableColumn fx:id="tcTipKontrole" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" text="Tip kontrole" />
                                          <TableColumn fx:id="tcKorisnickoIme" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="100.0" text="Korisnicko ime" />
                                          <TableColumn fx:id="tcAkcija" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefWidth="130.0" />
                                       </columns>
                                       <GridPane.margin>
                                          <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                       </GridPane.margin>
                                    </TableView>
                                 </children>
                              </GridPane>
                           </children>
                           <GridPane.margin>
                              <Insets left="5.0" />
                           </GridPane.margin>
                        </VBox>
                     </children>
                  </GridPane>
               </children>
               <GridPane.margin>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
               </GridPane.margin>
            </HBox>
            <HBox alignment="CENTER" spacing="35.0" GridPane.rowIndex="2">
               <GridPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="5.0" />
               </GridPane.margin>
               <children>
                  <Button fx:id="btnOk" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#potvrdi" prefHeight="45.0" prefWidth="80.0" styleClass="btnPrihvati" text="Prihvati" />
                  <Button fx:id="btnOtkazi" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#otkazi" prefHeight="45.0" prefWidth="80.0" styleClass="btnIzadji" text="Odustani" />
               </children>
            </HBox>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </GridPane>
   </children>
</VBox>
