<ns1:deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:java="http://xml.apache.org/axis/wsdd/providers/java" xmlns:ns1="http://xml.apache.org/axis/wsdd/">
 <ns1:globalConfiguration>
  <ns1:parameter name="sendMultiRefs" value="true"/>
  <ns1:parameter name="disablePrettyXML" value="true"/>
  <ns1:parameter name="adminPassword" value="admin"/>
  <ns1:parameter name="attachments.Directory" value="F:\Edukacija\Programiranje\MDP\Projektni\Aktivno\.metadata\.plugins\org.eclipse.wst.server.core\tmp0\wtpwebapps\Prelazak_Granice_Servis\WEB-INF\attachments"/>
  <ns1:parameter name="dotNetSoapEncFix" value="true"/>
  <ns1:parameter name="enableNamespacePrefixOptimization" value="false"/>
  <ns1:parameter name="sendXMLDeclaration" value="true"/>
  <ns1:parameter name="attachments.implementation" value="org.apache.axis.attachments.AttachmentsImpl"/>
  <ns1:parameter name="sendXsiTypes" value="true"/>
  <ns1:requestFlow>
   <ns1:handler type="java:org.apache.axis.handlers.JWSHandler">
    <ns1:parameter name="scope" value="session"/>
   </ns1:handler>
   <ns1:handler type="java:org.apache.axis.handlers.JWSHandler">
    <ns1:parameter name="scope" value="request"/>
    <ns1:parameter name="extension" value=".jwr"/>
   </ns1:handler>
  </ns1:requestFlow>
 </ns1:globalConfiguration>
 <ns1:handler name="URLMapper" type="java:org.apache.axis.handlers.http.URLMapper"/>
 <ns1:handler name="Authenticate" type="java:org.apache.axis.handlers.SimpleAuthenticationHandler"/>
 <ns1:handler name="LocalResponder" type="java:org.apache.axis.transport.local.LocalResponder"/>
 <ns1:service name="AdminService" provider="java:MSG">
  <ns1:parameter name="allowedMethods" value="AdminService"/>
  <ns1:parameter name="enableRemoteAdmin" value="false"/>
  <ns1:parameter name="className" value="org.apache.axis.utils.Admin"/>
  <ns1:namespace>http://xml.apache.org/axis/wsdd/</ns1:namespace>
 </ns1:service>
 <ns1:service name="Version" provider="java:RPC">
  <ns1:parameter name="allowedMethods" value="getVersion"/>
  <ns1:parameter name="className" value="org.apache.axis.Version"/>
 </ns1:service>
 <ns1:service name="TransitSOAP" provider="java:RPC" style="wrapped" use="literal">
  <ns2:operation name="dodajProlazak" qname="ns1:dodajProlazak" soapAction="" xmlns:ns1="http://transit.soap.etf.unibl.org" xmlns:ns2="http://xml.apache.org/axis/wsdd/">
   <ns2:parameter qname="ns1:idTerminal" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns2:parameter qname="ns1:idKontrola" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns3:parameter qname="ns1:prolazak" type="ns2:ProlazakDTO" xmlns:ns2="http://model.etf.unibl.org" xmlns:ns3="http://xml.apache.org/axis/wsdd/"/>
  </ns2:operation>
  <ns1:operation name="azurirajProlazak" qname="ns3:azurirajProlazak" soapAction="" xmlns:ns3="http://transit.soap.etf.unibl.org">
   <ns1:parameter qname="ns3:idKontrola" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns3:prolazak" type="ns4:ProlazakDTO" xmlns:ns4="http://model.etf.unibl.org"/>
  </ns1:operation>
  <ns1:operation name="odjavaKontrole" qname="ns5:odjavaKontrole" soapAction="" xmlns:ns5="http://transit.soap.etf.unibl.org">
   <ns1:parameter qname="ns5:idKontrola" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns5:idTerminal" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:operation name="provjeriDostupnost" qname="ns6:provjeriDostupnost" returnQName="ns6:provjeriDostupnostReturn" returnType="xsd:boolean" soapAction="" xmlns:ns6="http://transit.soap.etf.unibl.org" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <ns1:parameter qname="ns6:idTerminal" type="xsd:string"/>
  </ns1:operation>
  <ns1:operation name="promjeniDostupnost" qname="ns7:promjeniDostupnost" soapAction="" xmlns:ns7="http://transit.soap.etf.unibl.org">
   <ns1:parameter qname="ns7:idTerminal" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns7:status" type="xsd:boolean" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:operation name="provjeriOsobu" qname="ns8:provjeriOsobu" returnQName="ns8:provjeriOsobuReturn" returnType="ns9:ProlazakDTO" soapAction="" xmlns:ns8="http://transit.soap.etf.unibl.org" xmlns:ns9="http://model.etf.unibl.org">
   <ns1:parameter qname="ns8:idKontrola" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns8:statusProlaska" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:operation name="provjeraStatusaKontrole" qname="ns10:provjeraStatusaKontrole" returnQName="ns10:provjeraStatusaKontroleReturn" returnType="xsd:string" soapAction="" xmlns:ns10="http://transit.soap.etf.unibl.org" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <ns1:parameter qname="ns10:idKontrola" type="xsd:string"/>
  </ns1:operation>
  <ns1:operation name="registracijaKontrole" qname="ns11:registracijaKontrole" returnQName="ns11:registracijaKontroleReturn" returnType="xsd:boolean" soapAction="" xmlns:ns11="http://transit.soap.etf.unibl.org" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
   <ns1:parameter qname="ns11:idKontrola" type="xsd:string"/>
   <ns1:parameter qname="ns11:idTerminal" type="xsd:string"/>
  </ns1:operation>
  <ns1:operation name="azurirajStatusKontrole" qname="ns12:azurirajStatusKontrole" soapAction="" xmlns:ns12="http://transit.soap.etf.unibl.org">
   <ns1:parameter qname="ns12:idTerminal" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns12:idKontrola" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns12:status" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:operation name="azurirajInformacije" qname="ns13:azurirajInformacije" returnQName="ns13:azurirajInformacijeReturn" returnType="ns14:ProlazakDTO" soapAction="" xmlns:ns13="http://transit.soap.etf.unibl.org" xmlns:ns14="http://model.etf.unibl.org">
   <ns1:parameter qname="ns13:idKontrola" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <ns1:parameter qname="ns13:idProlazak" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </ns1:operation>
  <ns1:parameter name="allowedMethods" value="azurirajProlazak provjeriOsobu provjeriDostupnost promjeniDostupnost registracijaKontrole dodajProlazak odjavaKontrole azurirajStatusKontrole azurirajInformacije provjeraStatusaKontrole"/>
  <ns1:parameter name="typeMappingVersion" value="1.2"/>
  <ns1:parameter name="wsdlPortType" value="TransitSOAP"/>
  <ns1:parameter name="className" value="org.unibl.etf.soap.transit.TransitSOAP"/>
  <ns1:parameter name="wsdlServicePort" value="TransitSOAP"/>
  <ns1:parameter name="schemaQualified" value="http://transit.soap.etf.unibl.org,http://model.etf.unibl.org"/>
  <ns1:parameter name="wsdlTargetNamespace" value="http://transit.soap.etf.unibl.org"/>
  <ns1:parameter name="wsdlServiceElement" value="TransitSOAPService"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns15:ProlazakDTO" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:org.unibl.etf.model.ProlazakDTO" xmlns:ns15="http://model.etf.unibl.org"/>
  <ns1:arrayMapping innerType="xsd:string" languageSpecificType="java:java.lang.String[]" qname="ns16:ArrayOf_xsd_string" xmlns:ns16="http://transit.soap.etf.unibl.org" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
 </ns1:service>
 <ns1:transport name="http">
  <ns1:requestFlow>
   <ns1:handler type="URLMapper"/>
   <ns1:handler type="java:org.apache.axis.handlers.http.HTTPAuthHandler"/>
  </ns1:requestFlow>
  <ns1:parameter name="qs:list" value="org.apache.axis.transport.http.QSListHandler"/>
  <ns1:parameter name="qs:wsdl" value="org.apache.axis.transport.http.QSWSDLHandler"/>
  <ns1:parameter name="qs.list" value="org.apache.axis.transport.http.QSListHandler"/>
  <ns1:parameter name="qs.method" value="org.apache.axis.transport.http.QSMethodHandler"/>
  <ns1:parameter name="qs:method" value="org.apache.axis.transport.http.QSMethodHandler"/>
  <ns1:parameter name="qs.wsdl" value="org.apache.axis.transport.http.QSWSDLHandler"/>
 </ns1:transport>
 <ns1:transport name="local">
  <ns1:responseFlow>
   <ns1:handler type="LocalResponder"/>
  </ns1:responseFlow>
 </ns1:transport>
</ns1:deployment>